# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model alias (defaults to gemini-4-hydrogen)
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing secret for short-lived session and QR access tokens
JWT_SECRET="replace-with-strong-random-secret"

# PAYMENT_GATEWAY_MODE: 'demo' or 'live' (Razorpay / Stripe server-side keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# SMS / WHATSAPP / EMAIL PROVIDERS (Optional; falls back to clearly labelled demo mode)
MSG91_AUTH_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
WHATSAPP_BUSINESS_TOKEN=""
